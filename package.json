{
  "name": "voltdex",
  "version": "1.1.0",
  "description": "Unofficial Pokémon data field guide for AI agents: lightweight MCP server & agent skill with multilingual search, battle stats, and sprite downloads.",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "src/",
    "data/",
    "SKILL.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "README.zh-TW.md"
  ],
  "bin": {
    "voltdex": "./index.mjs"
  },
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test test/*.test.mjs",
    "mcp": "node index.mjs --mcp",
    "build:data": "node scripts/build-data.mjs",
    "build:hero": "node scripts/build-hero.mjs"
  },
  "keywords": [
    "pokemon",
    "pokedex",
    "pokeapi",
    "mcp",
    "model-context-protocol",
    "claude-skill",
    "token-saving"
  ],
  "author": {
    "name": "cain19811028",
    "url": "https://github.com/cain19811028"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cain19811028/voltdex.git"
  },
  "homepage": "https://github.com/cain19811028/voltdex#readme",
  "bugs": {
    "url": "https://github.com/cain19811028/voltdex/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
